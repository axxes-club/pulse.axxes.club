# Shared AXXES identity PostgreSQL database (same as members.axxes.club)
DATABASE_URL=
# Must match members.axxes.club so both apps accept the same accounts
BETTER_AUTH_SECRET=
# Public URL of this app, e.g. https://manifest-axxes.vercel.app
BETTER_AUTH_URL=

# Isolated Pulse analytics PostgreSQL database (must differ from DATABASE_URL)
ANALYTICS_DATABASE_URL=
# At least 32 characters; used only server-side for rotating counting keys
PULSE_HASH_SECRET=
# Primary public host
# BETTER_AUTH_URL=https://pulse.axxes.app

# Scoped scheduled-maintenance bearer secret
PULSE_JOB_SECRET=

# AXXES Payments (payments.axxes.app): Pulse's own product key and event-signing secret
AXXES_PAYMENTS_KEY=
AXXES_PAYMENTS_EVENT_SECRET=
# Optional: "test" to use the Payments sandbox
AXXES_PAYMENTS_MODE=
# The AXXES owner's verified account ID; that account may turn on free owner access per organization
AXXES_OWNER_USER_ID=
